{
  "version": 2,
  "note": "Screening quiz spec. UI renders one question per screen. Money values are USD decimal strings parsed with minor(). APR entered in percent, stored as basis points (rateBps).",
  "questions": [
    {
      "id": "priorAdvisor",
      "section": "trust",
      "field": "trust.priorAdvisor",
      "type": "single",
      "prompt": "Have you ever paid for financial advice?",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        },
        {
          "value": "couldnt_afford",
          "label": "I've wanted to but couldn't afford it"
        }
      ],
      "required": false
    },
    {
      "id": "aiTrust",
      "section": "trust",
      "field": "trust.aiTrust",
      "type": "scale",
      "min": 1,
      "max": 5,
      "prompt": "How much do you trust AI with money questions?",
      "required": false
    },
    {
      "id": "trustNeeds",
      "section": "trust",
      "field": "trust.needs",
      "type": "multi",
      "prompt": "What would make you trust an answer?",
      "options": [
        {
          "value": "show_the_math",
          "label": "Show me the math"
        },
        {
          "value": "show_sources",
          "label": "Show where the advice comes from"
        },
        {
          "value": "known_philosophy",
          "label": "Use a philosophy I already trust"
        },
        {
          "value": "a_human",
          "label": "A real person checked it"
        }
      ],
      "required": false
    },
    {
      "id": "incomeVaries",
      "section": "income",
      "field": "incomeVaries",
      "type": "boolean",
      "prompt": "Does your income change month to month?",
      "required": true
    },
    {
      "id": "incomeHistory",
      "section": "income",
      "field": "incomeHistory",
      "type": "money_series",
      "months": 6,
      "prompt": "What did you take home each of the last 6 months?",
      "allowUnknown": true,
      "required": true
    },
    {
      "id": "incomeSources",
      "section": "income",
      "field": "incomeSources",
      "type": "multi",
      "prompt": "Where does your income come from?",
      "options": [
        {
          "value": "hourly_job",
          "label": "Hourly job"
        },
        {
          "value": "tips",
          "label": "Tips"
        },
        {
          "value": "gig_delivery",
          "label": "Gig or delivery apps"
        },
        {
          "value": "freelance",
          "label": "Freelance"
        },
        {
          "value": "stipend_aid",
          "label": "Stipend or financial aid"
        },
        {
          "value": "family",
          "label": "Help from family"
        }
      ],
      "required": false
    },
    {
      "id": "bills",
      "section": "bills",
      "field": "bills",
      "type": "rows",
      "columns": [
        {
          "key": "name",
          "type": "text"
        },
        {
          "key": "amount",
          "type": "money"
        },
        {
          "key": "dueDay",
          "type": "int",
          "min": 1,
          "max": 31
        }
      ],
      "prompt": "List your fixed monthly bills (rent, phone, car, insurance, subscriptions).",
      "required": false
    },
    {
      "id": "expenses",
      "section": "spending",
      "field": "expenses",
      "type": "rows",
      "fixedRows": [
        "food",
        "gas_transport",
        "fun"
      ],
      "columns": [
        {
          "key": "name",
          "type": "text"
        },
        {
          "key": "amount",
          "type": "money"
        }
      ],
      "prompt": "Roughly how much do you spend each month on food, gas, and fun?",
      "required": false
    },
    {
      "id": "debts",
      "section": "debt",
      "field": "debts",
      "type": "rows",
      "columns": [
        {
          "key": "name",
          "type": "text"
        },
        {
          "key": "balance",
          "type": "money"
        },
        {
          "key": "aprPercent",
          "type": "percent",
          "storeAs": "rateBps"
        },
        {
          "key": "minPayment",
          "type": "money"
        }
      ],
      "prompt": "Any debts? (credit cards, car loan, student loans, BNPL)",
      "required": false
    },
    {
      "id": "savings",
      "section": "savings",
      "field": "savings",
      "type": "money",
      "prompt": "How much cash could you reach today?",
      "required": false
    },
    {
      "id": "portfolio",
      "section": "portfolio",
      "field": "portfolio",
      "type": "single",
      "prompt": "Do you invest?",
      "options": [
        {
          "value": "upload_csv",
          "label": "Upload a CSV from my brokerage"
        },
        {
          "value": "connect_brokerage_sandbox",
          "label": "Connect my brokerage"
        },
        {
          "value": "skip",
          "label": "I don't invest yet"
        }
      ],
      "required": false
    },
    {
      "id": "goals",
      "section": "goals",
      "field": "goals",
      "type": "multi",
      "maxSelect": 2,
      "prompt": "Top goal for the next 12 months?",
      "options": [
        {
          "value": "stop_paycheck_to_paycheck",
          "label": "Stop living paycheck to paycheck"
        },
        {
          "value": "pay_off_debt",
          "label": "Pay off debt"
        },
        {
          "value": "emergency_fund",
          "label": "Build an emergency fund"
        },
        {
          "value": "start_investing",
          "label": "Start investing"
        },
        {
          "value": "big_purchase",
          "label": "Save for something big"
        }
      ],
      "required": false
    },
    {
      "id": "personaHint",
      "section": "style",
      "field": "personaHint",
      "type": "single",
      "prompt": "Which statement do you agree with most?",
      "options": [
        {
          "value": "debt-free-coach",
          "label": "Debt is the enemy. Get out and stay out."
        },
        {
          "value": "asset-builder",
          "label": "Buy things that pay me, not things that cost me."
        },
        {
          "value": "conscious-spender",
          "label": "Spend on what I love, cut what I don't."
        },
        {
          "value": "value-investor",
          "label": "Keep it simple and let time do the work."
        }
      ],
      "required": false
    }
  ],
  "snapshot": {
    "note": "Computed in code after the quiz, never by the model.",
    "fields": [
      "lowestMonth",
      "averageMonth",
      "swing",
      "fixedBillsTotal",
      "lowestMonthShortfall",
      "portfolioValue"
    ]
  },
  "sectionWhy": {
    "trust": "So your mentor knows what earns your trust.",
    "income": "Your lowest month is the number we plan around.",
    "bills": "Fixed bills come first in every plan.",
    "spending": "Rough is fine. This is where small cuts come from.",
    "debt": "Balance, interest rate and minimum let us map your payoff.",
    "savings": "Your cushion decides how risky a low month is.",
    "portfolio": "Optional. We never ask for a brokerage password.",
    "goals": "Your mentor weighs options against this.",
    "style": "This suggests a mentor. You can switch anytime."
  }
}
