{
  "version": 3,
  "note": "Six-screen optional intake for a personal snapshot. Documents and portfolio can be added separately.",
  "questions": [
    {
      "id": "incomeHistory",
      "section": "income",
      "field": "incomeHistory",
      "type": "money_series",
      "months": 3,
      "prompt": "What did you take home in the last 3 months?",
      "allowUnknown": true,
      "required": true
    },
    {
      "id": "bills",
      "section": "bills",
      "field": "bills",
      "type": "rows",
      "columns": [
        {
          "key": "name",
          "type": "text"
        },
        {
          "key": "amount",
          "type": "money"
        },
        {
          "key": "dueDay",
          "type": "int",
          "min": 1,
          "max": 31
        }
      ],
      "prompt": "What are your main monthly bills?",
      "required": false
    },
    {
      "id": "expenses",
      "section": "spending",
      "field": "expenses",
      "type": "rows",
      "fixedRows": [
        "food",
        "gas_transport",
        "fun"
      ],
      "columns": [
        {
          "key": "name",
          "type": "text"
        },
        {
          "key": "amount",
          "type": "money"
        }
      ],
      "prompt": "About how much do you spend on everyday things each month?",
      "required": false
    },
    {
      "id": "debts",
      "section": "debt",
      "field": "debts",
      "type": "rows",
      "columns": [
        {
          "key": "name",
          "type": "text"
        },
        {
          "key": "balance",
          "type": "money"
        },
        {
          "key": "aprPercent",
          "type": "percent",
          "storeAs": "rateBps"
        },
        {
          "key": "minPayment",
          "type": "money"
        }
      ],
      "prompt": "Any debts you want to plan around?",
      "required": false
    },
    {
      "id": "savings",
      "section": "savings",
      "field": "savings",
      "type": "money",
      "prompt": "About how much cash do you have set aside?",
      "required": false
    },
    {
      "id": "goals",
      "section": "goals",
      "field": "goals",
      "type": "multi",
      "maxSelect": 2,
      "prompt": "What would you like to work on first?",
      "options": [
        {
          "value": "stop_paycheck_to_paycheck",
          "label": "Stop living paycheck to paycheck"
        },
        {
          "value": "pay_off_debt",
          "label": "Pay off debt"
        },
        {
          "value": "emergency_fund",
          "label": "Build an emergency fund"
        },
        {
          "value": "start_investing",
          "label": "Start investing"
        },
        {
          "value": "big_purchase",
          "label": "Save for something big"
        }
      ],
      "required": false
    }
  ],
  "snapshot": {
    "note": "Computed in code after the quiz, never by the model.",
    "fields": [
      "lowestMonth",
      "averageMonth",
      "swing",
      "fixedBillsTotal",
      "lowestMonthShortfall",
      "portfolioValue"
    ]
  },
  "sectionWhy": {
    "trust": "So your mentor knows what earns your trust.",
    "income": "Your lowest month is the number we plan around.",
    "bills": "Fixed bills come first in every plan.",
    "spending": "Rough is fine. This is where small cuts come from.",
    "debt": "Balance, interest rate and minimum let us map your payoff.",
    "savings": "Your cushion decides how risky a low month is.",
    "portfolio": "Optional. We never ask for a brokerage password.",
    "goals": "Your mentor weighs options against this.",
    "style": "This suggests a mentor. You can switch anytime."
  }
}
