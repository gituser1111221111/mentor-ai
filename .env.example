# Copy to .env for local runs. Never commit .env. Every value is read on the server only.
# Offline demo and tests work without any values (npm test, or MENTOR_ENGINE=mock for local practice).
# Minimum for the hackathon demo: MENTOR_API_KEY. Add the two ElevenLabs values for voice.

# ---------------------------------------------------------------------------
# REQUIRED: AI mentor chat (Anthropic Claude)
# ---------------------------------------------------------------------------
# MENTOR_API_KEY takes priority over ANTHROPIC_API_KEY (use it locally if your machine
# already has a different ANTHROPIC_API_KEY set). On Render, either name works.
# Without it, chat returns "Chat is not set up on this server yet"; budget, portfolio and lessons still work.
MENTOR_API_KEY=
# Sonnet for generation, input extraction, and mentor responses.
MENTOR_GENERATE_MODEL=claude-sonnet-5-5
MENTOR_PICK_MODEL=claude-sonnet-5-5
# MENTOR_ENGINE=mock            # force the rule-based practice engine (local tests only, never for the live demo)
# CHAT_LIMIT_PER_HOUR=40        # per-IP limit on model-backed routes
PORT=4180
# HOST=0.0.0.0                  # required on Render (render.yaml sets it)

# ---------------------------------------------------------------------------
# RECOMMENDED: voice (ElevenLabs speech-to-text + text-to-speech; no ElevenLabs Agent)
# ---------------------------------------------------------------------------
# Without ELEVENLABS_API_KEY the mic and Listen buttons are hidden and text chat works as before.
ELEVENLABS_API_KEY=
# Voice for the Dave Ramsey-inspired mentor (the only mentor with a voice). Set this ID, or name a voice
# exactly "Dave Ramsey" in your ElevenLabs account so the server can find it.
ELEVENLABS_VOICE_DEBT_FREE_COACH=
# ELEVENLABS_VOICE_ID=          # fallback voice ID if the mentor-specific one is not set
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ElevenLabs' own number normalization: auto (default), on, off. 'on' is Enterprise-only on flash/turbo models.
# Amounts are already spelled out by lib/speech-numbers.js before text reaches ElevenLabs.
# ELEVENLABS_TEXT_NORMALIZATION=auto

# ---------------------------------------------------------------------------
# OPTIONAL: live market data for portfolio review (all server-side)
# ---------------------------------------------------------------------------
# Without them, prices and events come from the dated snapshot in data/market/snapshot.json and are labeled "snapshot".
# Finnhub (free key, 60 calls/min): quotes, 52-week range, P/E, earnings calendar, EPS history, analyst ratings, news.
FINNHUB_API_KEY=
# Alpha Vantage: optional quote fallback when Finnhub is not set or returns no price (free tier is 25 calls/day).
ALPHA_VANTAGE_API_KEY=
# FRED (free key): fed funds, 2Y/10Y Treasury, unemployment.
FRED_API_KEY=
# SEC EDGAR needs no key, only an identifying User-Agent, e.g. "Mentor Labs team@example.com". Enables latest 10-K/10-Q/8-K links.
SEC_USER_AGENT=
# CoinGecko needs no key (public price endpoint for BTC/ETH/SOL/DOGE holdings).
# MARKET_LIVE=0                 # disable all market network calls (tests, offline demo)
# MARKET_TIMEOUT_MS=3500        # per-request timeout before falling back to the snapshot
# MARKET_CACHE_MS=900000        # quote cache lifetime (15 minutes)

# ---------------------------------------------------------------------------
# OPTIONAL: session storage
# ---------------------------------------------------------------------------
# Anonymous sessions (profile, budget, holdings, chat) are saved to .data/store.json by default.
# On Render's free plan that disk is wiped on every deploy or restart. Point this at a mounted disk to keep sessions.
# STORE_FILE=/var/data/store.json

# ---------------------------------------------------------------------------
# NOT USED BY THE MENTOR LABS DEMO (legacy starter routes and unwired helpers)
# ---------------------------------------------------------------------------
# Supabase and LlamaParse back only the starter's /api/teams, /api/datasets and /api/documents routes,
# which the app does not call. They load only when one of those routes is used.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Short-lived signed-in user's access token for CLI scripts only; never a service-role key.
SUPABASE_ACCESS_TOKEN=
LLAMA_CLOUD_API_KEY=
# FDIC, Stripe and Plaid helpers exist in lib/sources.js and lib/sandboxes.js but no route calls them.
FDIC_API_KEY=
STRIPE_TEST_SECRET_KEY=
# STRIPE_PRICE_ID=
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=

# ---------------------------------------------------------------------------
# Tuning (optional)
# ---------------------------------------------------------------------------
# How many verified options the coach may build and the mentor may choose from per answer (6-40, default 40).
# Lower it (e.g. 12) if live answers or voice replies feel slow; higher values cost more per answer.
# MENTOR_MAX_OPTIONS=12
# Progressive answers: the mentor first answers from a small verified set, "Show more options" grows it to MENTOR_MAX_OPTIONS.
# MENTOR_INITIAL_OPTIONS=8
# MENTOR_INITIAL_EFFORT=low          # reasoning effort for the first, small option set
# Response targets in ms (flag only; nothing is cut off). Over the threshold the UI says it is taking longer.
# MENTOR_TARGET_FIRST_MS=5000
# MENTOR_TARGET_PREFERRED_MS=8000
# MENTOR_TARGET_THRESHOLD_MS=10000
# MENTOR_DEBUG_PERF=1                 # development only: GET /api/perf returns avg/median/P90/P95 per stage
