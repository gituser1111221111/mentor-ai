# Offline demo and tests work without any values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Short-lived signed-in user's access token for CLI only; never service-role key.
SUPABASE_ACCESS_TOKEN=
LLAMA_CLOUD_API_KEY=
# Market data for the Portfolio Review and Equity Research agents (server-side only, all optional).
# Without them, answers use the dated fallback in data/market/snapshot.json and say so.
# Finnhub (free key, 60 calls/min): quotes, 52-week range, P/E, earnings calendar, EPS history, analyst ratings, news.
FINNHUB_API_KEY=
# Alpha Vantage: optional quote fallback only when Finnhub is not set (free tier is 25 calls/day).
ALPHA_VANTAGE_API_KEY=
# FRED (free key): fed funds, 2Y/10Y Treasury, unemployment.
FRED_API_KEY=
FDIC_API_KEY=
# SEC EDGAR needs no key, only an identifying User-Agent, e.g. "Mentor Labs team@example.com". Enables latest 10-K/10-Q/8-K links.
SEC_USER_AGENT=
# MARKET_LIVE=0                 # disable all market network calls (tests, offline demo)
STRIPE_TEST_SECRET_KEY=
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PORT=4180
# Mentor app. MENTOR_API_KEY takes priority over ANTHROPIC_API_KEY (use it locally if your machine
# already has a different ANTHROPIC_API_KEY set). On Render, either name works.
MENTOR_API_KEY=
# MENTOR_ENGINE=mock            # force the rule-based engine
# CHAT_LIMIT_PER_HOUR=40
# HOST=0.0.0.0                  # required on Render
# Stripe TEST mode only (sk_test_...). Optional STRIPE_PRICE_ID, else an inline $4.99/month price is used.
# STRIPE_PRICE_ID=
# ElevenLabs voice (speech-to-text + text-to-speech only; no ElevenLabs Agent). Server-side only.
# Without ELEVENLABS_API_KEY the mic and Listen buttons are hidden and text chat works as before.
ELEVENLABS_API_KEY=
# Demo voice for the Dave Ramsey-inspired mentor. Set either ID, or name a voice
# exactly "Dave Ramsey" in your ElevenLabs account so the server can find it.
ELEVENLABS_VOICE_DEBT_FREE_COACH=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ElevenLabs' own number normalization: auto (default), on, off. 'on' is Enterprise-only on flash/turbo models.
# Amounts are already spelled out by lib/speech-numbers.js before text reaches ElevenLabs.
# ELEVENLABS_TEXT_NORMALIZATION=auto
# How many verified options the coach may build and the mentor may choose from per answer (6-40, default 40).
# Lower it (e.g. 12) if live answers or voice replies feel slow; higher values cost more per answer.
# MENTOR_MAX_OPTIONS=12
# Progressive answers: the mentor first answers from a small verified set, "Show more options" grows it to MENTOR_MAX_OPTIONS.
# MENTOR_INITIAL_OPTIONS=8
# MENTOR_INITIAL_EFFORT=low          # reasoning effort for the first, small option set
# Response targets in ms (flag only; nothing is cut off). Over the threshold the UI says it is taking longer.
# MENTOR_TARGET_FIRST_MS=5000
# MENTOR_TARGET_PREFERRED_MS=8000
# MENTOR_TARGET_THRESHOLD_MS=10000
# MENTOR_DEBUG_PERF=1                 # development only: GET /api/perf returns avg/median/P90/P95 per stage

# Sonnet for generation, input extraction, and mentor responses.
MENTOR_GENERATE_MODEL=claude-sonnet-5-5
MENTOR_PICK_MODEL=claude-sonnet-5-5
